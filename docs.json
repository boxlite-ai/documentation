            "group": "Human tools",
            "icon": "user",
            "root": "human-tools/index",
            "pages": [
              "human-tools/desktop-access",
              "human-tools/browser-access"
            ]
          },
          {
            "group": "From demo to production",
            "icon": "map",
            "root": "guides/index",
            "pages": [
              "guides/error-handling",
              "guides/at-scale",
              "guides/deployment",
              "guides/agent-service-endpoint",
              "guides/image-registry-configuration"
