            "pages": [
              "cloud/box-costs",
              "cloud/cost-controls",
              "cloud/plans",
              "cloud/billing"
            ]
          }
        ]
      },
      {
        "tab": "Use cases",
        "groups": [
          {
            "group": "Use cases",
            "icon": "lightbulb",
            "root": "use-cases/index",
            "pages": [
              "use-cases/code-interpreter",
              "use-cases/data-analysis-agent",
              "use-cases/sandboxed-web-app",
              "use-cases/mcp-tool-server",
              "use-cases/sandboxed-ci",
              "use-cases/computer-use-agent",
              "use-cases/web-scraping-agent",
              "use-cases/custom-agent-image",
              "use-cases/interactive-dev-environment",
              "use-cases/untrusted-tool-execution"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "href": "/",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "primary": {
      "type": "github",
