{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BoxLite Documentation",
  "colors": {
    "primary": "#00B0F0",
    "light": "#38C7FF",
    "dark": "#0090C8"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "IBM Plex Mono"
    },
    "body": {
      "family": "Inter"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#13161B"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "BoxLite Open Source",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "root": "index",
            "pages": [
              "getting-started/index",
              "getting-started/quickstart",
              "getting-started/installation"
            ]
          },
          {
            "group": "Manage sandboxes",
            "icon": "cube",
            "root": "manage-sandbox/index",
            "pages": [
              "manage-sandbox/sandbox-types",
              "manage-sandbox/lifecycle",
              "manage-sandbox/environment",
              "manage-sandbox/compute-resources",
              "manage-sandbox/volumes",
              "manage-sandbox/network-access",
              "manage-sandbox/snapshots",
              "manage-sandbox/secrets-and-security"
            ]
          },
          {
            "group": "Agent tools",
            "icon": "screwdriver-wrench",
            "root": "agent-tools/index",
            "pages": [
              "agent-tools/code-execution-python",
              "agent-tools/code-execution-any-language",
              "agent-tools/pseudo-terminal",
              "agent-tools/computer-use",
              "agent-tools/browser-automation",
              "agent-tools/drive-from-agent-loop",
              "agent-tools/mcp-server",
              "agent-tools/github-operations"
            ]
          },
          {
            "group": "Agent in a box",
            "icon": "robot",
            "root": "agent-in-box/index",
            "pages": [
              "agent-in-box/run-claude-code",
              "agent-in-box/run-codex",
              "agent-in-box/run-pi",
              "agent-in-box/run-opencode",
              "agent-in-box/run-hermes"
            ]
          },
